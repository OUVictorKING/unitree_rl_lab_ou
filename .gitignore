# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!/.vscode
.vscode/browse.vc.db*

# Local-only Claude Code config
.claude/

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# Training logs / runs / recordings (user explicitly excluded logs/)
**/runs/*
**/logs/*
**/logs_*/
**/recordings/*

# Pre-Trained Checkpoints (kept local only)
/.pretrained_checkpoints/
*.pt

# Teleop Recorded Dataset
datasets

# Local-only large dirs / external data not pushed to fork
/dotpg/
/motion_datasets/
/robojudo/

# Random archives / one-off binaries
n.zip
**/pingpong.zip

# Mujoco / runtime debug files
MUJOCO_LOG.TXT
/tmp*.xml

# Heavy media accidentally placed inside source dirs
**/*.pdf
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv
